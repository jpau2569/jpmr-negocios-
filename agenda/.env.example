# OLVIDO DE PAU AGENDA — variables de la FASE 2 (hoy no se usa ninguna).
# Van en Vercel → Settings → Environment Variables. NUNCA en el código ni en el navegador.

# Supabase (cuenta, base de datos con RLS y archivos privados)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Google Calendar (OAuth de tipo «aplicación web» en Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# https://<tu-dominio>/api/agenda-google?accion=vuelta
GOOGLE_REDIRECT_URI=
# 32 bytes aleatorios en base64 para cifrar el refresh_token
AGENDA_CLAVE_CIFRADO=

# Asistente con IA (fase 3). Si falta, el asistente sale como «pendiente».
ANTHROPIC_API_KEY=
AGENDA_IA=no
