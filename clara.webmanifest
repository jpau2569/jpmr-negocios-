{
  "name": "CLARA — Tu asistente IA avatar",
  "short_name": "Clara",
  "description": "Asistente personal con IA de Pau: trabajo, estudios, coaching, software, investigación y negocio inmobiliario.",
  "start_url": "clara.html",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#070b18",
  "theme_color": "#070b18",
  "lang": "es",
  "icons": [
    {
      "src": "clara-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "clara-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "clara-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "id": "clara.html",
  "scope": "/",
  "share_target": {
    "action": "/clara-compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "archivos",
          "accept": [
            "image/*",
            "application/pdf",
            ".jpg",
            ".jpeg",
            ".png",
            ".webp",
            ".pdf"
          ]
        }
      ]
    }
  }
}
