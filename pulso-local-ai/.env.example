# --- Supabase -----------------------------------------------------------------
# La URL y la clave anon son públicas por diseño: lo que protege los datos es
# RLS (sql/02_rls.sql), no el secreto de esta clave.
NEXT_PUBLIC_SUPABASE_URL=https://tuproyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NUNCA con prefijo NEXT_PUBLIC_. Solo la usan los Route Handlers del servidor
# para escribir formularios públicos y eventos de analítica.
SUPABASE_SERVICE_ROLE_KEY=

# --- Aplicación ---------------------------------------------------------------
# Base con la que se construyen los enlaces de los QR. En local, http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp comercial de Pulso Local AI (el CTA de "reactivar mi espacio").
# Solo dígitos con prefijo de país.
NEXT_PUBLIC_PULSO_WHATSAPP=

# --- Opcional -----------------------------------------------------------------
# Sin esta clave el asistente NO llama a ningún modelo: responde con lo que hay
# publicado y, si no lo sabe, remite al local. Es deliberado.
ANTHROPIC_API_KEY=
