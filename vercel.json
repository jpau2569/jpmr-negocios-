{
  "functions": {
    "api/[ruta].js": {
      "maxDuration": 60,
      "includeFiles": "{agentes/**,sol-niebla-agua/api/**,chivato/datos/**}"
    }
  },
  "crons": [
    {
      "path": "/api/briefing",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/castebot-informe",
      "schedule": "0 7 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/p/:slug",
      "destination": "/api/oportunidades-ficha?slug=:slug"
    }
  ]
}
