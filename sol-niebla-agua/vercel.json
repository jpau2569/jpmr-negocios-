{
  "rewrites": [
    { "source": "/", "destination": "/app.html" }
  ],
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0" }]
    },
    {
      "source": "/manifest.json",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0" }]
    }
  ],
  "functions": {
    "api/tiempo.js": { "maxDuration": 30 }
  }
}
