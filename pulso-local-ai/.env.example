# ============================================================================
#  PULSO LOCAL AI — variables de entorno
#  Copia este fichero a .env.local y rellénalo. .env.local NO se sube a git.
# ============================================================================

# --- Supabase (Project Settings → API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# CLAVE SECRETA. Salta RLS. Solo se usa en rutas de servidor.
# Nunca la pongas en una variable NEXT_PUBLIC_ ni la pegues en el navegador.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Cadena de conexión directa, solo para `npm run db:migrate` y `db:seed`
# (Project Settings → Database → Connection string → URI).
SUPABASE_DB_URL=postgresql://postgres:CONTRASENA@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# --- Aplicación ---------------------------------------------------------------
NEXT_PUBLIC_URL_APP=http://localhost:3000

# Sal del servidor para los hashes de IP de consentimientos y límite de peticiones.
# Genera una con: node -e "console.log(crypto.randomUUID())"
SAL_CONSENTIMIENTO=cambia-esto-por-una-cadena-larga-y-aleatoria

# WhatsApp del SaaS para el botón «Reactivar mi espacio» de las demos caducadas.
WHATSAPP_SAAS=

# Secreto del cron de Vercel que caduca las demos (cabecera Authorization: Bearer ...).
CRON_SECRET=cambia-esto-tambien

# Dominios permitidos para next/image, separados por comas.
NEXT_PUBLIC_DOMINIOS_IMAGEN=images.unsplash.com
